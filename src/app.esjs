importar { Terminal } desde '@es-js/terminal'
importar { validarSecreto } desde 'https://desarrollo-aplicaciones.vercel.app/2024/code/validar-secreto.js'
importar { obtenerJson } desde 'https://desarrollo-aplicaciones.vercel.app/2024/code/obtener-json.js'

Terminal.escribir("Ingresa tu DNI:")
const dni = esperar Terminal.leer()

Terminal.escribir("Ingresa tu palabra secreta:")
const palabra = esperar Terminal.leer()

Terminal.escribir("Cargando...")

si (esperar validarSecreto(dni, palabra)) {
  const dolar = esperar obtenerJson("https://dolarapi.com/v1/dolares/blue")

  Terminal.escribir("Cotización del Dolar Blue")
  Terminal.escribir("Venta: $" + dolar.venta)
  Terminal.escribir("Compra: $" + dolar.compra)
  Terminal.escribir("Promedio: $" + (dolar.compra + dolar.venta) / 2)
} sino {
  Terminal.escribir("DNI o palabra secreta incorrectos")
}
